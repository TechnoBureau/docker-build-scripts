# GPG checks are intentionally disabled for lockfile generation. If an RPM is
# unsigned or has a bad signature, a gpgcheck failure during lockfile updates
# is silent and hard to debug. Disabling gpgcheck here means any such problem
# surfaces as a failed container build instead, which is visible as a red MR.
[public-hummingbird-x86_64-rpms]
name=public-hummingbird-x86_64-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/x86_64/
enabled=1
sslverify=1
gpgcheck=0
priority=10
# ncurses-6.5-8.20250614.hum1: published multiple times with different hashes
# nghttp3-1.13.1-1.hum1: published multiple times with different hashes
excludepkgs=ncurses-6.5-8.20250614.hum1.* ncurses-base-6.5-8.20250614.hum1.* ncurses-c++-libs-6.5-8.20250614.hum1.* ncurses-compat-libs-6.5-8.20250614.hum1.* ncurses-devel-6.5-8.20250614.hum1.* ncurses-libs-6.5-8.20250614.hum1.* ncurses-static-6.5-8.20250614.hum1.* ncurses-term-6.5-8.20250614.hum1.* libnghttp3-1.13.1-1.hum1.* libnghttp3-devel-1.13.1-1.hum1.*
zchunk=false

[public-hummingbird-aarch64-rpms]
name=public-hummingbird-aarch64-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/aarch64/
enabled=1
sslverify=1
gpgcheck=0
priority=10
# ncurses-6.5-8.20250614.hum1: published multiple times with different hashes
# nghttp3-1.13.1-1.hum1: published multiple times with different hashes
excludepkgs=ncurses-6.5-8.20250614.hum1.* ncurses-base-6.5-8.20250614.hum1.* ncurses-c++-libs-6.5-8.20250614.hum1.* ncurses-compat-libs-6.5-8.20250614.hum1.* ncurses-devel-6.5-8.20250614.hum1.* ncurses-libs-6.5-8.20250614.hum1.* ncurses-static-6.5-8.20250614.hum1.* ncurses-term-6.5-8.20250614.hum1.* libnghttp3-1.13.1-1.hum1.* libnghttp3-devel-1.13.1-1.hum1.*

[public-hummingbird-source-rpms]
name=public-hummingbird-source-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/source/
enabled=1
sslverify=1
gpgcheck=0
priority=10
zchunk=false
