{#- Package ARGs for the builder stage.

    The package sets are resolved in Python (hb_packages.resolve_package_set)
    from the same rule that produces rpms/rpms.in.yaml, so the versions
    resolved by get_rpm_versions.sh are exactly the versions installed here.
    Walking the rpm_packages/default_rpm_packages keys in Jinja — the previous
    implementation — duplicated that rule and had drifted from it: composite
    variants such as "fips-builder" lost rpm_packages.builder, and
    default_rpm_packages.<variant> was never installed at all.

    Sorted and deduplicated in Python, so the ARG line is stable across runs
    (a reordered package list would invalidate every downstream layer). -#}
{%- macro main_packages_arg() -%}
ARG MAIN_PACKAGES="{{ main_packages | join(' ') }}"
{%- for arch, pkgs in arch_specific_packages | dictsort %}
ARG ARCH_PACKAGES_{{ arch }}="{{ pkgs | join(' ') }}"
{%- endfor -%}
{%- endmacro -%}

{%- macro build_packages_arg() -%}
{%- if build_packages %}
ARG BUILD_PACKAGES="{{ build_packages | join(' ') }}"
{%- endif -%}
{%- endmacro -%}
