{%- macro setup_newroot() -%}
{%- if base_image %}
# The engine selects this image's TARGET platform, just like the builder stage.
# Only its filesystem is inherited; image metadata is defined by this template.
FROM {{ base_image }} AS hb_base

{% endif -%}
FROM quay.io/hummingbird-ci/hummingbird-builder:latest AS builder
# Defaults are stage-local: caller templates may define compiler stages first.
ARG NEWROOT=/new-root-fs
ARG DNF_CACHE=/tmp/dnf-cache
ARG TARGETARCH
ARG SOURCE_DATE_EPOCH
ARG DNF_FLAGS="-y \
      --use-host-config \
      --nodocs \
      --setopt=install_weak_deps=False \
      --setopt=reposdir=/etc/hb-repos \
{%- if distro != "hummingbird" %}
      --disablerepo=public-hummingbird* \
{%- endif %}
{%- if releasever %}
      --releasever={{ releasever }} \
{%- endif %}
      --setopt=cachedir=${DNF_CACHE} \
      --setopt=system_cachedir=${DNF_CACHE} \
      --setopt=logdir=${DNF_CACHE}"
# WHY an isolated reposdir: installed packages and version queries must use
# exactly the selected distro/additional repos, never the builder's other repos.
{%- for repo in distro_repos %}
COPY yum-repos/{{ repo }} /etc/hb-repos/{{ repo }}
{%- endfor %}
COPY --chmod=0755 hb-scripts/rootfs.sh /usr/local/bin/hb-rootfs
{{ main_packages_arg() }}
{{ build_packages_arg() }}

# Start blank even if the tooling image already carries a stale rootfs/RPM DB.
RUN hb-rootfs reset "${NEWROOT}" && mkdir -p "${DNF_CACHE}"
{%- if base_image %}
COPY --from=hb_base / ${NEWROOT}/
RUN hb-rootfs check-base "${NEWROOT}" "{{ distro }}"
{%- endif %}

{%- if is_builder %}
RUN mkdir -p "${NEWROOT}/etc/dnf/libdnf5.conf.d" && \
    printf '[main]\ninstall_weak_deps=False\ntsflags=nodocs\n' > "${NEWROOT}/etc/dnf/libdnf5.conf.d/90-builder-defaults.conf"
{%- endif %}

{%- if build_packages %}
# Build dependencies stay in the tooling stage, not in the image rootfs.
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    dnf ${DNF_FLAGS} install ${BUILD_PACKAGES}
{%- endif %}
{%- if build_arch_specific_packages %}
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    case "${TARGETARCH:-$(uname -m)}" in \
{%- for arch, pkgs in build_arch_specific_packages | dictsort %}
    {{ arch }}|{{ arch | targetarch }}) dnf ${DNF_FLAGS} install {{ pkgs | join(' ') }} ;; \
{%- endfor %}
    esac
{%- endif %}

{%- if distro == "hummingbird" %}
RUN rpmkeys --import /etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release --root "${NEWROOT}"
{%- endif %}
# RPM scriptlets chroot into NEWROOT. Temporary proc/dev/runtime mounts make
# /proc/self/exe and devices available there, including under Rosetta/QEMU.
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    hb-rootfs exec "${NEWROOT}" dnf ${DNF_FLAGS} --installroot="${NEWROOT}" install filesystem
{% endmacro -%}
