{%- macro install_newroot() -%}
{%- if base_image %}
# Refresh inherited packages using this distro's repositories before adding
# the requested runtime/FIPS packages. The seed's RPM database is preserved.
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    hb-rootfs exec "${NEWROOT}" dnf ${DNF_FLAGS} --installroot="${NEWROOT}" upgrade
{% endif -%}
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    hb-rootfs exec "${NEWROOT}" dnf ${DNF_FLAGS} --installroot="${NEWROOT}" install ${MAIN_PACKAGES}
{%- if arch_specific_packages %}
RUN --mount=type=cache,id=hb-dnf-{{ distro }}-${TARGETARCH},target=${DNF_CACHE},sharing=locked \
    case "${TARGETARCH:-$(uname -m)}" in \
{%- for arch, pkgs in arch_specific_packages | dictsort %}
    {{ arch }}|{{ arch | targetarch }}) \
        hb-rootfs exec "${NEWROOT}" dnf ${DNF_FLAGS} --installroot="${NEWROOT}" install {{ pkgs | join(' ') }} ;; \
{%- endfor %}
    esac
{%- endif %}
{%- if is_fips or crypto_policy != "DEFAULT" %}
# Apply and validate the selected policy independently of OSCAP scanning.
RUN hb-rootfs policy "${NEWROOT}" "{{ crypto_policy }}"
{%- endif %}
{%- if oscap.enabled
    and (distro == "hummingbird" or distro in oscap.datastreams)
    and image_name != "hummingbird-builder" %}
{{ verify_compliance() }}
{%- endif %}
{% endmacro -%}
