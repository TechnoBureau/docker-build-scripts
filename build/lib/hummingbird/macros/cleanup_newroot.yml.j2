{%- macro cleanup_newroot(keep_licenses=false) -%}
{%- if not is_builder %}
{% if remove_rpms_from_newroot is defined and remove_rpms_from_newroot -%}
RUN rpm --root "${NEWROOT}" -e {{ remove_rpms_from_newroot if remove_rpms_from_newroot is string else remove_rpms_from_newroot | join(' ') }} --nodeps
{% endif -%}
{% if not keep_licenses -%}
RUN rm -rf \
      ${NEWROOT}/usr/share/licenses \
      ${NEWROOT}/usr/share/locale
{% endif -%}
{%- endif %}
# Handles both RPM4 and RPM6 database layouts without creating dummy databases.
RUN hb-rootfs cleanup "${NEWROOT}"
{%- if is_fips %}
# Removal/customisation must not leave an image labelled FIPS without its provider.
RUN hb-rootfs policy "${NEWROOT}" "{{ crypto_policy }}"
{%- endif %}
{% endmacro -%}
