#!/bin/bash
# libhook - run lifecycle-hook commands with output redirected to PID 1 so it lands
# in the container log stream (only when PID 1's fds are writable by this user).

hook_run() {                          # hook_run <command...>
    if [[ -w /proc/1/fd/1 && -w /proc/1/fd/2 ]]; then
        exec "$@" >/proc/1/fd/1 2>/proc/1/fd/2
    else
        exec "$@"
    fi
}
