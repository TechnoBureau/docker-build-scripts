#!/bin/bash
# libentrypoint - container entrypoint helpers: run user init scripts from
# INITSCRIPTS_DIR with no ownership changes, no ACLs and JSON logging.

# shellcheck source=/usr/local/bin/liblog
. /usr/local/bin/liblog
entrypoint_init_scripts() {           # entrypoint_init_scripts : run user init scripts
    local dir="${INITSCRIPTS_DIR:-${HOME:-/}/docker-entrypoint-initdb.d}"
    local -a files=("$dir"/*.sh)
    local f=""
    if [[ ! -e "${files[0]:-}" ]]; then
        info "No custom scripts in ${dir}"
        return 0
    fi
    info "Loading user's custom files from ${dir} ..."
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue          # regular files only
        if [[ -x "$f" ]]; then
            debug "Executing $f"
            "$f"
        else
            debug "Sourcing $f"
            . "$f"
        fi
    done
}
